{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arqtiqa.github.io/arqtos/schema/status_view.v1.schema.json",
  "title": "StatusView v1 \u2014 a disposable projection",
  "description": "Authoritative for nothing. Deleting it entirely must leave governed verification valid, and rebuilding from zero must reach the same result.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "rebuilt_through_sequence",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1",
      "description": "An integer carried as its canonical decimal string. The canonical encoding forbids JSON numbers."
    },
    "kind": {
      "type": "string",
      "const": "status_view"
    },
    "rebuilt_through_sequence": {
      "type": "string",
      "pattern": "^(0|-?[1-9][0-9]*)$",
      "description": "An integer carried as its canonical decimal string. The canonical encoding forbids JSON numbers."
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "act_body_id",
          "state"
        ],
        "properties": {
          "act_body_id": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "description": "Derived, never authored."
          },
          "desired_spec_id": {
            "type": "string"
          },
          "observed_spec_id": {
            "type": "string"
          }
        }
      }
    }
  }
}
