// Command {{.BinaryName}} is a Track-B (out-of-process) arqtos Roster
// connector, generated by create-arqtos-connector from the same proven shape
// as arqtos-sdk-go's examples/roster-provider. It compiles and passes
// rosterconform right now, against the placeholder directory below, before a
// single line of real logic exists.
//
// Swap {{.StructName}}'s method bodies for calls to {{.ConnectorName}}'s real
// API, one method at a time, and re-run `go test ./...` after each: the
// in-process conformance run in conform_test.go stays green only if the three
// properties below survive the swap.
//
// # The two mistakes this contract has already made someone pay for
//
//  1. An unresolved read must never arrive as an empty directory. Every list
//     method below goes through roster.Resolved (never a bare slice) or
//     roster.EmptyRoster (never a zero value) — see the comment on each. This
//     SDK's Roster wire protocol went through a breaking rewrite (v0.2.0)
//     precisely because a naive `repeated`-field mapping let an
//     unauthenticated, throttled, or truncated read arrive indistinguishable,
//     ON THE WIRE, from "the directory genuinely has nobody in it" — four
//     different accidental encodings, all readable, all empty, none of them
//     an error. A host that believes the second reading revokes every access
//     in the estate. If your real API call fails, or your own pagination
//     stops partway through, return a typed cerr error
//     (cerr.KindUnavailable, cerr.KindTimeout, ...) instead — never let a
//     failed or partial read fall through to Resolved/EmptyRoster.
//  2. Capabilities() must be HONEST, and honesty can only be checked from two
//     INDEPENDENT signals. Capabilities() below is a hardcoded literal, not a
//     read of connector.yml or of anything Capabilities() itself returns —
//     see its doc comment for why deriving one from the other makes
//     rosterconform's capability-honesty check agree with itself no matter
//     what this binary actually does.
//
// # Watch is not on this wire
//
// roster.CapWatch has NO RPC in this SDK's Track-B transport (see
// arqtos-sdk-go's plugin/roster.go) — a dispensed out-of-process stub never
// satisfies roster.Watcher, whatever a provider declares. So this binary
// cannot declare watch: Capabilities() below does not return it, and
// connector.yml does not list it. Do not add it to either. A host without
// CapWatch already polls on its own reconcile interval — that is the
// capability's own documented fallback, not a degraded connector.
//
// # Running this
//
//	go build -o bin/{{.BinaryName}} .
//
// produces the provider binary. A real host launches that binary and dials
// it over go-plugin/gRPC; it is never run directly from a shell.
// conform_test.go's in-process run is the fast feedback loop while you edit —
// ask whoever owns your arqtos host integration to run arqtos-sdk-go's
// rosterconform.RunOutOfProcess against the built binary before you ship.
// That spawn deliberately lives on the SDK/host side of this boundary rather
// than in this repository's own tests: a connector repository forbids
// os/exec in its own package tree (see arqtos-sdk-go's README and
// rosterconform/outofprocess.go for why), so this skeleton does not carry an
// out-of-process test of its own.
//
// No real directory data: every identifier below is a placeholder, and none
// of them names anybody.
package main

import (
	"context"

	goplugin "github.com/hashicorp/go-plugin"

	"github.com/arqtiqa/arqtos-sdk-go/cerr"
	"github.com/arqtiqa/arqtos-sdk-go/connector"
	"github.com/arqtiqa/arqtos-sdk-go/plugin"
	"github.com/arqtiqa/arqtos-sdk-go/roster"
)

// Placeholder directory identifiers, kept here rather than duplicated in
// conform_test.go so the served directory and the conformance fixtures can
// never drift apart. Delete these once {{.StructName}}'s methods call your
// real API.
const (
	// fixtureGroup is populated, and has an INHERITED member — which is what
	// makes the transitive_membership declaration below checkable rather
	// than merely stated.
	fixtureGroup = "{{.Group}}"
	// fixtureNestedGroup is nested inside fixtureGroup; its direct member is
	// fixtureGroup's inherited one.
	fixtureNestedGroup = "{{.NestedGroup}}"
	// fixtureParentGroup is the group fixtureGroup is nested inside.
	fixtureParentGroup = "{{.ParentGroup}}"
	// fixtureEmptyGroup EXISTS and has no members — a real state, and not
	// the same answer as a group that does not exist.
	fixtureEmptyGroup = "{{.EmptyGroup}}"
	// fixtureAbsentGroup is served by nothing: it must fail NotFound.
	fixtureAbsentGroup = "{{.AbsentGroup}}"

	fixtureActive    = "{{.ActivePrincipal}}"
	fixtureSuspended = "{{.SuspendedPrincipal}}"
	fixtureMachine   = "{{.MachinePrincipal}}"

	// minHostVersion is what THIS connector's connector.yml declares as
	// min_host_version. Keep the two in sync by hand — see the comment on
	// that field in connector.yml.
	minHostVersion = "{{.MinHostVersion}}"
)

// {{.StructName}} is the placeholder Roster implementation. Rename it, give
// it whatever fields your real client needs (an HTTP client, an API token
// resolved via a CredentialLoader connector — never a literal secret), and
// replace each method body with a call to {{.ConnectorName}}'s API. Keep the
// roster.Resolved / roster.EmptyRoster / cerr.New shapes exactly as they are:
// they are the whole point of the class, not incidental wiring.
type {{.StructName}} struct{}

// ListPrincipals returns every identity in the directory, INCLUDING
// deactivated ones (Active: false — never omitted; see mistake #1 above).
//
// roster.Resolved refuses a nil/empty slice, so a read that produced nothing
// cannot silently become "the directory has nobody in it" — but only for
// what you pass it. If your real read paginates internally, do NOT assert
// roster.Complete on a page fetched before a failure: return a typed cerr
// error instead (cerr.KindUnavailable, cerr.KindTimeout, ...), the same way
// you would for a call that never got a first page. A truncated principal
// list is readable, non-empty, and indistinguishable from a complete one to
// everything downstream — and a sweep run against one revokes everyone past
// the failure point.
func (p *{{.StructName}}) ListPrincipals(_ context.Context) (roster.Resolution[roster.Principal], error) {
	// TODO: replace with a real directory read. Until then, this is a fixed
	// placeholder: one active human, one suspended human, one machine
	// identity.
	return roster.Resolved([]roster.Principal{
		{
			ID: fixtureActive, Handle: "placeholder-active",
			Email: "placeholder-active@example.invalid", DisplayName: "Placeholder Active",
			Active: true, Kind: roster.PrincipalHuman,
		},
		{
			// Deactivated, and STILL IN THE DIRECTORY. Omitting a
			// deactivated identity tells the host the person left the
			// organisation, and the host then revokes everything belonging
			// to somebody who is on leave.
			ID: fixtureSuspended, Handle: "placeholder-suspended",
			Email: "placeholder-suspended@example.invalid", DisplayName: "Placeholder Suspended",
			Active: false, Kind: roster.PrincipalHuman,
		},
		{
			// A machine identity: no mailbox, and that is not an error.
			// Reporting one requires roster.CapMachinePrincipals, declared
			// in Capabilities below AND in connector.yml. Delete this
			// principal (and the capability, in both places) if
			// {{.ConnectorName}} has no separate machine-identity concept.
			ID: fixtureMachine, Handle: "placeholder-service-identity",
			DisplayName: "Placeholder Service Identity",
			Active:      true, Kind: roster.PrincipalMachine,
		},
	}, roster.Complete)
}

// ListGroups returns every group in the directory.
//
// The same rule as ListPrincipals applies: a read that failed or stopped
// partway through is a typed cerr error, never roster.Resolved(whatever, roster.Complete)
// and never roster.EmptyRoster — that assertion is for a directory that
// GENUINELY has no groups, verified by a backend that can tell "found
// nothing" from "could not read".
func (p *{{.StructName}}) ListGroups(_ context.Context) (roster.Resolution[roster.Group], error) {
	// TODO: replace with a real directory read.
	return roster.Resolved([]roster.Group{
		{
			ID: fixtureGroup, Handle: "placeholder-engineering", DisplayName: "Placeholder Engineering",
			ParentIDs: []string{fixtureParentGroup},
		},
		{ID: fixtureParentGroup, Handle: "placeholder-all", DisplayName: "Placeholder All"},
		{
			ID: fixtureNestedGroup, Handle: "placeholder-platform", DisplayName: "Placeholder Platform",
			ParentIDs: []string{fixtureGroup},
		},
		{ID: fixtureEmptyGroup, Handle: "placeholder-just-created", DisplayName: "Placeholder Just Created"},
	}, roster.Complete)
}

// ListMemberships is where the two answers that must never be confused live
// side by side: an existing group with no members is roster.EmptyRoster, and
// a group that does not exist is cerr.KindNotFound. "This group has no
// members" and "there is no such group" lead a reconcile loop to opposite
// conclusions, and confusing them is mistake #1 in its most concrete form.
//
// Every returned Membership.GroupID MUST equal groupID — a host cannot
// attribute a membership for a group it did not ask about.
func (p *{{.StructName}}) ListMemberships(_ context.Context, groupID string) (roster.Resolution[roster.Membership], error) {
	// TODO: replace every case with a real directory read for groupID.
	switch groupID {
	case fixtureGroup:
		return roster.Resolved([]roster.Membership{
			{PrincipalID: fixtureActive, GroupID: fixtureGroup, Direct: true},
			{PrincipalID: fixtureSuspended, GroupID: fixtureGroup, Direct: true},
			{
				// INHERITED, through fixtureNestedGroup's nesting.
				// Reporting one requires roster.CapTransitiveMembership.
				PrincipalID: fixtureMachine, GroupID: fixtureGroup, Direct: false,
			},
		}, roster.Complete)
	case fixtureNestedGroup:
		return roster.Resolved([]roster.Membership{
			{PrincipalID: fixtureMachine, GroupID: fixtureNestedGroup, Direct: true},
		}, roster.Complete)
	case fixtureParentGroup:
		return roster.Resolved([]roster.Membership{
			{PrincipalID: fixtureActive, GroupID: fixtureParentGroup, Direct: false},
		}, roster.Complete)
	case fixtureEmptyGroup:
		// This backend can tell "read successfully, found nobody" from
		// "could not read", so it may assert emptiness. One that cannot has
		// a failure on its hands, not an empty group.
		return roster.EmptyRoster[roster.Membership](), nil
	default:
		// NOT an empty roster. A reconcile loop given one for a group that
		// does not exist removes the access that group carried.
		return roster.Resolution[roster.Membership]{}, cerr.New(cerr.KindNotFound, "ListMemberships", nil)
	}
}

func (p *{{.StructName}}) Implements() connector.Class { return connector.ClassRoster }

// Capabilities declares what THIS BINARY actually implements — hardcoded,
// never derived from connector.yml, from a shared variable, or from anything
// Capabilities() itself returns.
//
// This is mistake #2. If Capabilities() read connector.yml and echoed it
// back, the two would always agree by construction: a stale connector.yml
// claiming a capability nobody wrote code for would pass
// rosterconform's capability-honesty check every single time, because
// "declared" and "implemented" would be reading the same signal twice. This
// SDK has shipped that exact bug once already, in an earlier connector
// class's out-of-process harness. Add or remove a capability HERE only when
// you add or remove the code that does it, and make the SAME edit by hand in
// connector.yml — the check exists precisely to catch the moment those two
// drift apart.
//
// roster.CapWatch is deliberately absent: see the package comment above for
// why an out-of-process provider cannot declare it.
func (p *{{.StructName}}) Capabilities() connector.Capabilities {
	return connector.Capabilities{roster.CapTransitiveMembership, roster.CapMachinePrincipals}
}

func (p *{{.StructName}}) Health(_ context.Context) (connector.Health, error) {
	return connector.Health{Status: connector.Healthy, Detail: "placeholder directory, always reachable"}, nil
}

// Close releases what the connector holds. A real connector closes its
// directory API session here; it is called by the host over the wire, and it
// must be idempotent.
func (p *{{.StructName}}) Close() error { return nil }

var _ roster.Roster = (*{{.StructName}})(nil)

func main() {
	goplugin.Serve(&goplugin.ServeConfig{
		HandshakeConfig: plugin.Handshake,
		Plugins:         plugin.RosterPluginMap(&{{.StructName}}{}),
		GRPCServer:      goplugin.DefaultGRPCServer,
	})
}
